# Port the server listens on (pick another if 4000 is taken)
PORT=4000
# Required in production: a random string of 32+ characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# How long a session lasts, in seconds
SESSION_TTL_SECONDS=3600
# Comma-separated list of front-end origins allowed to call the API (CORS + CSRF origin check)
CORS_ORIGIN=http://localhost:5173
# Sign-in attempts allowed per IP per minute (email and passkey)
RATE_LIMIT_PER_MINUTE=10
# Send the cookie over HTTPS only (defaults to true when NODE_ENV=production)
COOKIE_SECURE=false
# strict (default) | lax | none. Use "none" only if the front end is on another site (needs COOKIE_SECURE=true)
COOKIE_SAME_SITE=strict
# Passkeys: the domain passkeys belong to (default: host of the first CORS_ORIGIN)
WEBAUTHN_RP_ID=
# Passkeys: name shown in the browser's passkey prompt
WEBAUTHN_RP_NAME=Email Auth
# Passkeys: allowed origins, comma-separated (default: CORS_ORIGIN)
WEBAUTHN_ORIGINS=
