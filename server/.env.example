# Port the server listens on
PORT=4000
# Required in production: a random string of 32+ characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# How long a session lasts, in seconds
SESSION_TTL_SECONDS=3600
# Comma-separated list of front-end origins allowed to call the API (with cookies)
CORS_ORIGIN=http://localhost:5173
# Send the cookie over HTTPS only (defaults to true when NODE_ENV=production)
COOKIE_SECURE=false
