# Serves the demo and proxies the API on the same origin, so the session
# cookie is first-party (SameSite=Strict works) and no CORS is involved.
# The nginx image fills in the API_UPSTREAM variable from the environment at start-up.
server {
  listen 8080;
  root /usr/share/nginx/html;

  location ~ ^/(create-token|me|logout|passkeys) {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri /index.html;
  }
}
